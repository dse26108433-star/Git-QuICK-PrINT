# ---------------------------------------------------------------------
# Backend settings. Copy this file to ".env" (same folder) and fill in
# each value. The backend reads .env by itself when you start it from
# this folder, e.g. with:  mvn spring-boot:run
# NEVER commit the real .env file or share it.
# ---------------------------------------------------------------------

# Supabase dashboard -> Connect -> "Session pooler" -> JDBC tab.
# It looks like: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Put ONLY the part before "?user=" here, and add ?sslmode=require at the end.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Session pooler user looks like postgres.abcdefghijklmnop (note the dot)
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=your-database-password

# Supabase dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SECRET key (sb_secret_...). Legacy service_role (eyJ...) also works.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# How students pay:
#   demo     = NO real money, a test button marks orders paid. For testing only.
#   razorpay = real payments. Get keys at dashboard.razorpay.com -> Account & Settings
#              -> API Keys. Test keys start with rzp_test_ (no real money).
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Password for the Xerox staff screen (web/counter.html). 8+ characters.
COUNTER_PASSWORD=change-this-counter-password

# Any random text, at least 32 characters. Make one up and keep it secret.
AGENT_TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Where the web pages are opened from (comma separated)
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The XeoGo websites on Netlify: the headers every page is sent with.
# Netlify reads this file whichever way the site gets there: the web folder dragged onto
# the Netlify page, or the repository connected with base directory "web".

# The Content-Security-Policy line below: only this site's own scripts run here (plus Razorpay's payment screen when the
# shop uses it). The keys of a student's orders live in this browser; no other website's code gets near them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: blob: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src https://*.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# config.js changes when the backend moves: never cache it for long.
/config.js
  Cache-Control: no-cache

# The website's own code: always check for a newer version (small files; the service worker keeps a copy).
/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

# PDF.js and the QR code library, kept with the site (exact versions; they change only with a new release).
/vendor/*
  Cache-Control: public, max-age=604800

# The "install as an app" parts: always check for a newer version.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

/staff.webmanifest
  Content-Type: application/manifest+json

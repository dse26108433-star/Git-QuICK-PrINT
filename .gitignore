agent/packaging/out/
installer/*.exe

# PostgreSQL and cloudflared, downloaded once by build-installer.ps1 (about 390 MB)
agent/packaging/cache/

# the Android apps on the download page: copied in for publishing, not kept in git
web/download/*.apk
